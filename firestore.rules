rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for Custom Claims & Multi-Tenant RBAC
    function isAuthenticated() {
      return request.auth != null;
    }

    function getRole() {
      return request.auth.token.role;
    }

    function getSchoolId() {
      return request.auth.token.schoolId;
    }

    function isSuperAdmin() {
      return isAuthenticated() && getRole() == 'superAdmin';
    }

    function isSchoolAdmin(targetSchoolId) {
      return isAuthenticated() && (
        isSuperAdmin() || 
        (getRole() == 'schoolAdmin' && getSchoolId() == targetSchoolId)
      );
    }

    function isSchoolTeacher(targetSchoolId) {
      return isAuthenticated() && (
        isSchoolAdmin(targetSchoolId) || 
        (getRole() == 'teacher' && getSchoolId() == targetSchoolId)
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Schools Collection: Public directory reads, strict administrative writes
    match /schools/{schoolId} {
      allow read: if true; // Public for discovery directory & SEO
      allow create, delete: if isSuperAdmin();
      allow update: if isSchoolAdmin(schoolId);
    }

    // 2. Users Collection: Strict isolation by User ID and School boundary
    match /users/{userId} {
      allow read: if isOwner(userId) || 
                     (isAuthenticated() && isSchoolTeacher(resource.data.schoolId));
      allow create: if isOwner(userId) && 
                       request.resource.data.uid == request.auth.uid &&
                       request.resource.data.role == 'parent';
      allow update: if isOwner(userId) || isSuperAdmin();
      allow delete: if isSuperAdmin();

      // 2a. Subcollection: Module Progress & Stars
      match /progress/{moduleId} {
        allow read: if isOwner(userId) || 
                       (isAuthenticated() && (isSchoolTeacher(getSchoolId()) || isSuperAdmin()));
        allow write: if isOwner(userId) || isSuperAdmin();
      }

      // 2b. Subcollection: Weak Spots Practice Tracking
      match /weakSpots/{itemId} {
        allow read: if isOwner(userId) || 
                       (isAuthenticated() && (isSchoolTeacher(getSchoolId()) || isSuperAdmin()));
        allow write: if isOwner(userId) || isSuperAdmin();
      }

      // 2c. Subcollection: Drawing & Art Gallery
      match /gallery/{itemId} {
        allow read: if isOwner(userId) || 
                       (isAuthenticated() && (isSchoolTeacher(getSchoolId()) || isSuperAdmin()));
        allow write: if isOwner(userId) || isSuperAdmin();
      }

      // 2d. Subcollection: Mini-Game Saves & Levels
      match /games/{gameId} {
        allow read: if isOwner(userId) || 
                       (isAuthenticated() && (isSchoolTeacher(getSchoolId()) || isSuperAdmin()));
        allow write: if isOwner(userId) || isSuperAdmin();
      }
    }

    // 3. Learning Progress Collection: Secure tenant data isolation
    match /learning_progress/{progressId} {
      allow read: if isAuthenticated() && (
        resource.data.parentId == request.auth.uid ||
        isSchoolTeacher(resource.data.schoolId)
      );
      allow create: if isAuthenticated() && 
                       request.resource.data.parentId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.parentId == request.auth.uid ||
        isSchoolTeacher(resource.data.schoolId)
      );
      allow delete: if isSuperAdmin();
    }
  }
}
